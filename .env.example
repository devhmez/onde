# Copy to .env (production, read by docker compose) or .env.local (development).
# Names only: fill in your own values. Full runbook: docs/DEPLOY.md

# Public origin of the site, e.g. https://example.com
PUBLIC_BASE_URL=
# Optional separate hostname for the admin dashboard
ADMIN_HOST=

# Admin login. ADMIN_PASSWORD_HASH is a bcrypt hash in the base64: form (see docs/DEPLOY.md)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
COOKIE_SECURE=true

# SQLite database file
DATABASE_PATH=./data/onde.db

# Web push (VAPID key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Search engine verification and IndexNow (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
