# Keep the Docker build context small and free of secrets / local state.

# Dependencies and build output are recreated inside the image
node_modules
.next
out
tsconfig.tsbuildinfo

# Local data, backups and secrets — never baked into an image
data
backups
.env
.env.*
!.env.example
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db.gz

# VCS, editors, OS junk, logs
.git
.gitignore
.vscode
.idea
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage

# Deployment / docs files the image does not need
Dockerfile
.dockerignore
docker-compose.yml
Caddyfile
docs
README.md
AGENTS.md
CLAUDE.md
scripts/backup.sh
scripts/deploy.sh

# Local dev admin password (never in an image)
.admin-dev-password
